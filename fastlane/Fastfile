default_platform(:ios)
opt_out_usage

platform :ios do
  desc "Загрузить IPA в TestFlight без распространения"
  lane :upload_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH"),
      duration: 1_200,
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_STORE_BUNDLE_ID"),
      ipa: ENV.fetch("APP_STORE_IPA_PATH"),
      # CI лишь передаёт IPA в App Store Connect: TestFlight и App Store
      # статусы остаются под ручным контролем команды.
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )
  end
end
