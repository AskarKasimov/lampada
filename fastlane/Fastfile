default_platform(:ios)
opt_out_usage

platform :ios do
  desc "Загрузить IPA, витринные материалы и отправить версию на App Review"
  lane :submit_for_review do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH"),
      duration: 1_200,
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_STORE_BUNDLE_ID"),
      ipa: ENV.fetch("APP_STORE_IPA_PATH"),
      app_version: ENV.fetch("APP_STORE_VERSION"),
      build_number: ENV.fetch("APP_STORE_BUILD_NUMBER"),
      metadata_path: ENV.fetch("APP_STORE_METADATA_PATH"),
      screenshots_path: ENV.fetch("APP_STORE_SCREENSHOTS_PATH"),
      force: true,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
    )
  end
end
